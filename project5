#include <stdio.h>
#include <conio.h>

void main()
{
    FILE *fp;
    char name[300];


    // 1. Writing data into file
    fp = fopen("Divagar.txt", "w");

    if (fp == NULL) 
    {
        printf("File cannot be opened");
        return;
    }
  
    fprintf(fp, "c program is a very useful and intresting language.previously,another sir taught us this subject,but i couldn't understand the concepts properly.  ") ;

    fclose(fp);

    printf("Data written successfully\n");


    // 2. Appending data into file
    fp = fopen("Divagar.txt", "a");

    if (fp == NULL)
    {
        printf("File cannot be opened");
        return;
    }

    fprintf(fp, "\nAravind sir teaches make everthing much easier for me to understand . His teaching method is very clear");

    fclose(fp);

    printf("Data appended successfully\n");


    // 3. Reading data from file
    fp = fopen("student.txt", "r");

    if (fp == NULL)
    {
        printf("File cannot be opened");
        return;
    }

    printf("\nFile Contents:\n");

    while (fgets(name, sizeof(name), fp) != NULL)
    {
        printf("%s", name);
    }

    fclose(fp);

}
